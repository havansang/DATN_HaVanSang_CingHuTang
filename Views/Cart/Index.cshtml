@{
    ViewData["Title"] = "CheckOut";

    var AccountId = ViewBag.Account.Id;
    string formattedFee = "";
    try{
        int fee = Convert.ToInt32(ViewBag.fee);
        int roundedFee = (int)Math.Ceiling(fee / 100.0) * 100;

        // Định dạng với dấu phân cách hàng nghìn
         formattedFee = roundedFee.ToString("N0", new System.Globalization.CultureInfo("en-US"));
    }
    catch
    {
         formattedFee = "Nhập lại địa chỉ";
    }
}

<link href="~/css/client/cart.css" rel="stylesheet" />
<input type="number" value="@AccountId" id="accountId" hidden />
<div class="container">
    <div style="height:50px"></div>
    <div class="row">
        <div class="col-xl-8">
            <div id="cart_item">
               

            </div>

            <div class="row my-4">
                <div class="col-sm-6">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-link text-muted">
                        <i class="bi bi-arrow-left-short"></i> Tiếp tục xem sản phẩm
                    </a>
                </div> <!-- end col -->
            </div> <!-- end row-->
        </div>

        <div class="col-xl-4">


            <div class="mt-5 mt-lg-0">
                <div class="card border shadow-none">
                    <div class="card-header bg-transparent border-bottom py-3 px-4">
                        <div class="col-12">
                            <label for="customer_name" class="form-label form-label-sm mb-0">Tên<span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="customer_name" autocomplete="off" value="@ViewBag.Account.FullName">
                        </div>

                        <div class="col-12">
                            <label for="customer_phone" class="form-label form-label-sm mb-0">Điện thoại<span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="customer_phone" autocomplete="off" value="@ViewBag.Account.PhoneNumber">
                        </div>

                        <div class="col-12">
                            <label for="customer_address" class="form-label form-label-sm mb-0">Địa chỉ<span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="customer_address" autocomplete="off" value="@ViewBag.Account.Address">
                        </div>
                    </div>
                    <div class="card-body p-4 pt-2">
                        <h5 class="font-size-16 mb-0">
                            Đơn hàng
                        </h5>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <tbody>
                                    <tr>
                                        <td>Tổng hàng:</td>
                                        <td class="text-end" id="sub_total">25,000 VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td>Phí vận chuyển:</td>
                                        <td class="text-end" id="shipping_charge">@formattedFee VNĐ</td>
                                    </tr>
                                    <tr class="bg-light">
                                        <th>Tổng:</th>
                                        <td class="text-end">
                                            <span class="fw-bold" id="total_money">
                                                125,000 VNĐ
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <div class="mt-2 mt-sm-0">
                    <button class="btn btn-success" onclick="CreateOrder()">
                        <i class="mdi mdi-cart-outline me-1"></i> Đặt hàng(Thanh toán COD)
                    </button>
                </div>
                <div class="mt-2 mt-sm-0" style="margin-top: 10px !important">
                    <button class="btn btn-success" onclick="CreateOrders()">
                        <i class="mdi mdi-cart-outline me-1"></i> Thanh toán bằng Vnpay
                    </button>
                </div>
                
                <div class="mt-2 mt-sm-0" style="margin-top: 10px !important">
                    <button class="btn btn-success" onclick="CreateOrderByWallet()">
                        <i class="mdi mdi-cart-outline me-1"></i> Thanh toán bằng số dư ví
                    </button>
                </div>
                
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Biến để kiểm tra địa chỉ có thay đổi không
            let lastAddress = '';

            // Sự kiện blur - khi click ra ngoài ô input
            $('#customer_address').on('blur', async function() {
                const currentAddress = $(this).val().trim();

                // Chỉ tính toán nếu địa chỉ thay đổi và không rỗng
                if (currentAddress && currentAddress !== lastAddress) {
                    try {
                        // Hiển thị trạng thái đang tính toán
                        //$('#dis').text("Đang tính...");
                        $('#shipping_charge').text("Đang tính...");

                        const response = await fetch('/Distance/CalculateShippingFee', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `deliveryAddress=${encodeURIComponent(currentAddress)}`
                        });

                        const data = await response.json();

                        if (data.error) {
                            alert(data.error);
                        } else {
                            //$('#shipping_charge').text(`${data.fee.toLocaleString()} VNĐ`);
                                const roundedFee = Math.ceil(data.fee / 100) * 100;
                            $('#shipping_charge').text(roundedFee.toLocaleString('en-US') + ' VNĐ');

                                 const total = parseFloat($('#sub_total').text().replace(/[^\d,]/g, '').replace(',', '.')) +
                                parseFloat($('#shipping_charge').text().replace(/[^\d,]/g, '').replace(',', '.'));
                                        const formattedTotal = total.toLocaleString('vi-VN', {
                                          minimumFractionDigits: 3,
                                          maximumFractionDigits: 3
                                        }).replace(/\./g, '');

                            $('#total_money').text(formattedTotal.toLocaleString('en-US') + ' VNĐ');
                            // Lưu lại địa chỉ vừa tính toán
                            lastAddress = currentAddress;
                        }
                    } catch (error) {
                        console.error("Lỗi:", error);
                        $('#shipping_charge').text("Lỗi tính phí");
                    }
                }
            });
        });
    </script>
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        form.addEventListener("submit", function () {
            const totalMoneyText = document.getElementById("total_money").innerText;
            const numericValue = totalMoneyText.replace(/[^\d]/g, "");
            document.querySelector("input[name='Amount']").value = numericValue;
        });
    });
</script>
<script src="~/js/client/cart.js"></script>
<script>
        function CreateOrders() {

        let cusName = $("#customer_name").val();
        let cusAddress = $("#customer_address").val();
        let cusPhone = $("#customer_phone").val();
        let accountId = $("#accountId").val();

        const priceText = document.getElementById('shipping_charge').textContent;
        const priceNumber = parseFloat(
        priceText
            .replace(/[^\d]/g, '') // Xóa tất cả ký tự không phải số và dấu chấm
    );
        if (cusName.length <= 0) {
            alert("Hãy nhập tên người mua!");
            return;
        }
        if (cusPhone.length <= 0) {
            alert("Hãy nhập số điện thoại!");
            return;
        }
        if (cusAddress.length <= 0) {
            alert("Hãy nhập địa chỉ!");
            return;
        }
        if (accountId <= 0) {
            alert("Hãy đăng nhập để sử dụng tính năng!");
            return;
        }

        let elQuantity = $(".quantity");
        let elProductDetailId = $(".productDetailId");
        let elTotalMoney = $(".totalPrice");
        let arrDetail = [];
        for (let i = 0; i < elQuantity.length; i++) {
            let arrTopping = [];
            $.each($(`.topping_price_${i}`), function (index, item) {
                let objTopping = {
                    ToppingId: parseInt($(item).attr("toppingId")),
                    ToppingPrice: parseInt($(item).attr("toppingPrice")),
                }
                arrTopping.push(objTopping);
            });



            let objDetail = {
                Quantity: parseInt($(elQuantity[i]).val()),
                TotalMoney: parseFloat($(elTotalMoney[i]).val()),
                ProductDetailId: parseInt($(elProductDetailId[i]).val()),
                LstTopping: arrTopping
            }
            arrDetail.push(objDetail);
        }
        let obj = {
            Details: arrDetail,
            CustomerName: cusName,
            PhoneNumber: cusPhone,
            Address: cusAddress,
            AccountId: accountId,
            ShippingFee: priceNumber
        }
        let obj1 = {
            Name: "Hà Văn Sáng",
            OrderDescription:"Thanh toán qua Vnpay",
            Amount:parseFloat(elTotalMoney),
            OrderType:"100000"
        }
        sessionStorage.setItem('pendingOrder', JSON.stringify(obj));
        const totalMoneyText = document.getElementById("total_money").innerText;
        const numericValue = totalMoneyText.replace(/[^\d]/g, "");
        let tong = numericValue;
        let nd = "Thanh toán qua Vnpay";
        let ma = "100000";

        const params = new URLSearchParams();
        params.append('cusName', cusName);
        params.append('nd', nd);
        params.append('tong', tong);
        params.append('ma', ma);

        // Chuyển hướng
        window.location.href = `/Payment/CreatePaymentUrlVnpay1?${params.toString()}`;
    }
</script>